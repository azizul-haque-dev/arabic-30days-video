{
  "name": "arabic-master-remotion",
  "version": "1.0.0",
  "private": true,
  "description": "Arabic Master - 30-Day Survival Arabic - Remotion episodes (Day 17: Restaurant Communication & Dining)",
  "scripts": {
    "discover": "tsx scripts/discover-audio.ts",
    "discover:strict": "tsx scripts/discover-audio.ts --strict",
    "dev": "tsx scripts/dev.ts",
    "studio": "tsx scripts/dev.ts",
    "typecheck": "tsc --noEmit",
    "validate:config": "tsx scripts/validate-config.ts",
    "validate:layout": "tsx scripts/validate-layout.ts",
    "validate": "npm run typecheck && npm run validate:config && npm run validate:layout",
    "still:thumbnail": "remotion still src/index.ts day-17-thumbnail out/day-17-thumbnail.png --overwrite",
    "render:day-17": "npm run discover:strict && npm run validate:layout && remotion render src/index.ts day-17 out/day-17.mp4 --codec h264 --crf 17",
    "stills": "tsx scripts/render-stills.ts"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.542",
    "@remotion/cli": "4.0.542",
    "@remotion/layout-utils": "4.0.542",
    "@remotion/media-utils": "4.0.542",
    "@remotion/renderer": "4.0.542",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "remotion": "4.0.542"
  },
  "devDependencies": {
    "@fontsource/hind-siliguri": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/noto-sans-arabic": "5.3.0",
    "@types/node": "24.0.0",
    "@types/react": "19.2.0",
    "music-metadata": "11.0.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}