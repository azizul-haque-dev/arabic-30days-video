{
  "name": "arabic-master",
  "version": "1.0.0",
  "private": true,
  "description": "Arabic Master - 30-Day Survival Arabic (Remotion)",
  "scripts": {
    "prepare:episode": "tsx scripts/prepare.ts",
    "validate": "tsx scripts/validate-layout.ts",
    "studio": "npm run prepare:episode && remotion studio src/index.ts",
    "render": "npm run prepare:episode && npm run validate && remotion render src/index.ts Episode out/video.mp4 --codec h264 --crf 18",
    "typecheck": "tsc --noEmit",
    "stills": "tsx scripts/stills.ts",
    "audit": "tsx scripts/audit-frames.ts"
  },
  "dependencies": {
    "@fontsource/hind-siliguri": "^5.0.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-sans-arabic": "^5.0.0",
    "@remotion/cli": "4.0.290",
    "@remotion/layout-utils": "4.0.290",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.290"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "tsx": "^4.19.0",
    "typescript": "5.6.3",
    "@remotion/bundler": "4.0.290",
    "@remotion/renderer": "4.0.290"
  }
}
