  "cues": {
    "1": {
      "start": 0.16,
      "end": 1.1,
      "text": "আসসালামু আলাইকুম।"
    },
    "2": {
      "start": 1.1,
      "end": 3.75,
      "text": "অ্যারাবিক মাস্টার পেজের পক্ষ থেকে আপনাদের স্বাগতম।"
    },
    "3": {
      "start": 3.75,
      "end": 8.5,
      "text": "আমাদের ৩০ দিনে ৩০০টি সারভাইভাল আরবি বাক্য শেখার আজ ১৭তম দিন।"
    },
    "4": {
      "start": 8.5,
      "end": 13.26,
      "text": "আলহামদুলিল্লাহ, আমরা ইতিমধ্যে ১৬০টি জরুরি আরবি বাক্য শেষ করেছি।"
    },
    "5": {
      "start": 13.94,
      "end": 17.04,
      "text": "আজকে আমরা শিখব রেস্টুরেন্ট ও কাজের জায়গায় কথা বলার জন্য"
    },
    "6": {
      "start": 17.76,
      "end": 20.6,
      "text": "১৬১ থেকে ১৭০ নম্বর বাক্য।"
    },
    "7": {
      "start": 20.6,
      "end": 21.92,
      "text": "চলুন শুরু করি।"
    },
    "8": {
      "start": 22.6,
      "end": 24.65,
      "text": "Sentence 161."
    },
    "9": {
      "start": 24.65,
      "end": 26.85,
      "text": "খাওয়া শেষে বিল চাওয়ার সময় বলুন:"
    },
    "10": {
      "start": 26.85,
      "end": 28.48,
      "text": "আল-হিসাব, লাউ সামাহত। (الحساب لو سمحت)"
    },
    "11": {
      "start": 29.1,
      "end": 30.56,
      "text": "আল-হিসাব, লাউ সামাহত। (الحساب لو سمحت)"
    },
    "12": {
      "start": 31.18,
      "end": 32.72,
      "text": "অর্থ: দয়া করে বিলটা দিন।"
    },
    "13": {
      "start": 33.34,
      "end": 35,
      "text": "Sentence 162."
    },
    "14": {
      "start": 35.82,
      "end": 38.3,
      "text": "নিজের খাবার বা অর্ডার দেখিয়ে বলুন:"
    },
    "15": {
      "start": 38.3,
      "end": 38.84,
      "text": "হাদা হাগ্গি। (هذا حقي)"
    },
    "16": {
      "start": 39.48,
      "end": 41.1,
      "text": "হাদা হাগ্গি। (هذا حقي)"
    },
    "17": {
      "start": 41.1,
      "end": 42.65,
      "text": "অর্থ: এটা আমার অর্ডার।"
    },
    "18": {
      "start": 42.65,
      "end": 44.04,
      "text": "Sentence 163."
    },
    "19": {
      "start": 44.04,
      "end": 46.44,
      "text": "অর্ডার আসতে দেরি হলে বলুন:"
    },
    "20": {
      "start": 47.5,
      "end": 48.4,
      "text": "মা জা তালাবি। (ما جاء طلبي)"
    },
    "21": {
      "start": 49.16,
      "end": 50.7,
      "text": "মা জা তালাবি। (ما جاء طلبي)"
    },
    "22": {
      "start": 50.7,
      "end": 52.2,
      "text": "অর্থ: আমার অর্ডার আসেনি।"
    },
    "23": {
      "start": 52.74,
      "end": 54.95,
      "text": "Sentence 164."
    },
    "24": {
      "start": 54.95,
      "end": 56.48,
      "text": "খাবার গরম না থাকলে বলুন:"
    },
    "25": {
      "start": 57.22,
      "end": 58.85,
      "text": "আল-আকেল বারিদ। (الأكل بارد)"
    },
    "26": {
      "start": 58.85,
      "end": 60.5,
      "text": "আল-আকেল বারিদ। (الأكل بارد)"
    },
    "27": {
      "start": 61.16,
      "end": 62.38,
      "text": "অর্থ: খাবার ঠান্ডা।"
    },
    "28": {
      "start": 63.28,
      "end": 65.1,
      "text": "Sentence 165."
    },
    "29": {
      "start": 65.1,
      "end": 66.92,
      "text": "এক্সট্রা রুটি লাগলে বলুন:"
    },
    "30": {
      "start": 67.54,
      "end": 69.4,
      "text": "আবগা খুবজ জিয়াদা। (أبغى خبز زيادة)"
    },
    "31": {
      "start": 69.4,
      "end": 71.22,
      "text": "আবগা খুবজ জিয়াদা। (أبغى خبز زيادة)"
    },
    "32": {
      "start": 72.12,
      "end": 73.6,
      "text": "অর্থ: আমি বাড়তি রুটি চাই।"
    },
    "33": {
      "start": 74.22,
      "end": 76.16,
      "text": "Sentence 166."
    },
    "34": {
      "start": 76.94,
      "end": 78.4,
      "text": "টেবিলে চামচ না থাকলে বলুন:"
    },
    "35": {
      "start": 79.24,
      "end": 80.32,
      "text": "নাগেস মিলাগা। (ناقص ملعقة)"
    },
    "36": {
      "start": 81.18,
      "end": 82.32,
      "text": "নাগেস মিলাগা। (ناقص ملعقة)"
    },
    "37": {
      "start": 83.06,
      "end": 84.7,
      "text": "অর্থ: একটা চামচ কম আছে।"
    },
    "38": {
      "start": 85.38,
      "end": 87.2,
      "text": "Sentence 167."
    },
    "39": {
      "start": 87.94,
      "end": 89.72,
      "text": "বেঁচে যাওয়া খাবার বাসায় নিতে বলুন:"
    },
    "40": {
      "start": 90.22,
      "end": 91.9,
      "text": "আল-বাগি আবগা সাফারি। (الباقي أبغى سفري)"
    },
    "41": {
      "start": 91.9,
      "end": 93.58,
      "text": "আল-বাগি আবগা সাফারি। (الباقي أبغى سفري)"
    },
    "42": {
      "start": 94.26,
      "end": 97.2,
      "text": "অর্থ: বাকিটা প্যাক করে দিন।"
    },
    "43": {
      "start": 97.2,
      "end": 98.3,
      "text": "Sentence 168."
    },
    "44": {
      "start": 98.4,
      "end": 100.9,
      "text": "রেস্টুরেন্টে না বসে পার্সেল নিতে চাইলে বলুন:"
    },
    "45": {
      "start": 101.26,
      "end": 102,
      "text": "আবগা সাফারি। (أبغى سفري)"
    },
    "46": {
      "start": 102.64,
      "end": 104,
      "text": "আবগা সাফারি। (أبغى سفري)"
    },
    "47": {
      "start": 104,
      "end": 105.44,
      "text": "অর্থ: আমি টেকঅ্যাওয়ে চাই।"
    },
    "48": {
      "start": 106.1,
      "end": 109.5,
      "text": "Sentence 169."
    },
    "49": {
      "start": 109.54,
      "end": 110.18,
      "text": "টেবিল খালি কিনা জানতে জিজ্ঞাসা করুন:"
    },
    "50": {
      "start": 110.86,
      "end": 112.45,
      "text": "আত-তাওলা মাহজুজা? (الطاولة محجوزة؟)"
    },
    "51": {
      "start": 112.45,
      "end": 114.08,
      "text": "আত-তাওলা মাহজুজা? (الطاولة محجوزة؟)"
    },
    "52": {
      "start": 114.82,
      "end": 117.2,
      "text": "অর্থ: টেবিলটি কি রিজার্ভ?"
    },
    "53": {
      "start": 117.2,
      "end": 117.94,
      "text": "Sentence 170."
    },
    "54": {
      "start": 118.48,
      "end": 121.22,
      "text": "দুজনের বসার জায়গা চাইলে বলুন:"
    },
    "55": {
      "start": 121.3,
      "end": 122.45,
      "text": "তাওলা লি ইথনেন। (طاولة لاثنين)"
    },
    "56": {
      "start": 122.45,
      "end": 123.6,
      "text": "তাওলা লি ইথনেন। (طاولة لاثنين)"
    },
    "57": {
      "start": 124.34,
      "end": 125.86,
      "text": "অর্থ: দুজনের জন্য টেবিল।"
    },
    "58": {
      "start": 126.6,
      "end": 130.16,
      "text": "ব্যাস, আজকের এই ১০টি সহ আমাদের মোট ১৭০টি বাক্য শেখা শেষ হলো।"
    },
    "59": {
      "start": 130.22,
      "end": 134.5,
      "text": "ভিডিওটি সেভ করে বারবার প্র্যাকটিস করুন।"
    },
    "60": {
      "start": 134.5,
      "end": 140.48,
      "text": "৩০ দিনের সারভাইভাল আরবিক সিরিজের পরের পর্বগুলো পেতে অ্যারাবিক মাস্টার পেজটি ফলো করে রাখুন।"
    },
    "61": {
      "start": 140.52,
      "end": 143.68,
      "text": "আবার দেখা হবে আগামীকাল ডে ১৮-তে, ইনশাআল্লাহ।"
    },
    "62": {
      "start": 143.68,
      "end": 144.14,
      "text": "আল্লাহ হাফেজ।"
    }
  },
