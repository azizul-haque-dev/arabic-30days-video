{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true, "skipLibCheck": true, "esModuleInterop": true, "noEmit": true, "lib": ["ES2022","DOM"]
  },
  "include": ["src"]
}
